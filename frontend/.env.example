# The origin the *browser* uses. It ends up inlined in the client bundle and in
# the curl example ClaimKey shows to paying API customers, so it must be the
# public one. On the VPS, nginx serves /api/ from the same host as the site.
#   production: NEXT_PUBLIC_API_URL=https://www.yotruck.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# The origin the *server* uses (lib/api.ts only). On the VPS this is uvicorn on
# loopback, so SSR and ISR never leave the box — no nginx hop, no TLS handshake,
# no public round trip. Not NEXT_PUBLIC_, so it stays out of the browser bundle.
# Leave empty in local dev; it falls back to NEXT_PUBLIC_API_URL.
#   production: INTERNAL_API_URL=http://127.0.0.1:8000
INTERNAL_API_URL=

# NEXT_PUBLIC_SITE_URL is gone on purpose: the canonical domain lives in
# lib/site.ts. An override here (or in the Vercel dashboard) pointed every
# canonical at the vercel.app host and got the pages dropped from the index.

# Paddle checkout. These are the *public* client-side values — the secret API key
# and webhook secret belong in the backend env, never here.
# Until both are set, the Growth CTA falls back to a mailto link.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH=pri_01kyw5zy3982s8ntx3mebyr2sm
NEXT_PUBLIC_PADDLE_PRICE_STANDARD=pri_01kyw66zdv6769svjtdc75a39p
NEXT_PUBLIC_PADDLE_PRICE_PRO=pri_01kyw77ngfmnth71115v4m4yd1

# Affiliate partner links, one per category. Each card only renders once its URL
# is set, so unsigned programs simply do not appear on the page.
NEXT_PUBLIC_AFF_INSURANCE_URL=
NEXT_PUBLIC_AFF_ELD_URL=
NEXT_PUBLIC_AFF_FACTORING_URL=
NEXT_PUBLIC_AFF_COMPLIANCE_URL=
