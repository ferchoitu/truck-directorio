DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carriercheck

# Optional: raises data.transportation.gov/Socrata rate limits.
SOCRATA_APP_TOKEN=

CORS_ORIGINS=https://www.yotruck.com,https://yotruck.com,http://localhost:3000

# Paddle billing. Use sandbox credentials until the flow is validated end-to-end.
# PADDLE_API_KEY is server-side only and must never reach the frontend bundle.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Price ids are not secret — they ship in the public frontend bundle either way.
# Growth $49/mo (50k req) · Standard $99.90/mo (150k) · Pro $149/mo (300k)
PADDLE_PRICE_ID_GROWTH=pri_01kyw5zy3982s8ntx3mebyr2sm
PADDLE_PRICE_ID_STANDARD=pri_01kyw66zdv6769svjtdc75a39p
PADDLE_PRICE_ID_PRO=pri_01kyw77ngfmnth71115v4m4yd1
